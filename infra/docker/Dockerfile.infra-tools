# syntax=docker/dockerfile:1
FROM alpine:3.20

RUN apk add --no-cache \
    bash \
    curl \
    coreutils \
    openssl \
    postgresql16-client \
    mongodb-tools \
    redis \
    mongosh

WORKDIR /scripts
COPY infra/scripts/ /scripts/
RUN chmod +x /scripts/*.sh

WORKDIR /backups
ENTRYPOINT ["/bin/bash"]
