{
  "name": "@urticketbuddy/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "typeorm": "typeorm-ts-node-commonjs",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "db:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "db:check": "ts-node src/check.ts"
  },
  "dependencies": {
    "@urticketbuddy/config": "workspace:*",
    "@urticketbuddy/contracts": "workspace:*",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
