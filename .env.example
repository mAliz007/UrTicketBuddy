# ==============================================================================
# UrTicketBuddy Environment Variables Configuration
# Copy this file to .env before starting services locally.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Service Ports
API_PORT=3000
REALTIME_PORT=3001
WORKER_PORT=3002
WEB_PORT=5173

# Postgres Database (Applications connect through PgBouncer on port 6432)
POSTGRES_HOST=localhost
POSTGRES_PORT=6432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urticketbuddy
POSTGRES_DIRECT_PORT=5432

# MongoDB (Venue layouts storage)
MONGO_URI=mongodb://localhost:27017/urticketbuddy

# Redis (Transient seat locking, RedisBloom, BullMQ, Socket.io adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (Read model search cluster)
ELASTICSEARCH_NODE=http://localhost:9200

# Authentication & Security Secrets
JWT_SECRET=development-jwt-secret-min-16-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=development-jwt-refresh-secret-min-16
JWT_REFRESH_EXPIRES_IN=7d

# Dynamic QR HMAC Key Generation (HKDF base secret - minimum 32 chars)
MASTER_TICKET_SECRET=dev-master-ticket-secret-32-chars-long-key

# Payment Gateways (Stripe test mode, Safepay)
STRIPE_SECRET_KEY=
SAFEPAY_API_KEY=

# Object Storage & CDN Caching
STORAGE_PROVIDER=local
S3_BUCKET=urticketbuddy-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:3000/media

# PgAdmin Web Management Interface
PGADMIN_DEFAULT_EMAIL=admin@urticketbuddy.local
PGADMIN_DEFAULT_PASSWORD=admin

# ==============================================================================
# Railway Production Deployment (UTB-18 Reference & CD Variables)
# Configure these in GitHub Repository Secrets & Variables for CD execution
# ==============================================================================
# RAILWAY_TOKEN=railway-api-or-project-token
# RAILWAY_SERVICE_API=api
# RAILWAY_SERVICE_REALTIME=realtime
# RAILWAY_SERVICE_WORKER=worker
# RAILWAY_HEALTH_URL=https://api.yourdomain.com

